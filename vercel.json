{
  "name": "rolhub",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 15 * * *"
    }
  ]
}
