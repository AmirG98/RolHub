# Auth - Clerk
# Obtén tus keys en: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Database - Supabase
# Obtén tus keys en: https://supabase.com
DATABASE_URL=postgresql://user:password@host:5432/database
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI APIs (Fase 2+)
# Anthropic Claude: https://console.anthropic.com
# Fal.ai: https://fal.ai
ANTHROPIC_API_KEY=sk-ant-...
FAL_KEY=...

# TTS Voice APIs (usar uno o ambos)
# Fish Audio (recomendado): https://fish.audio - voces ultra naturales, $15/M bytes
# Deepgram: https://deepgram.com - 90ms latencia, $200 crédito gratis
# Si ambos están configurados, Fish Audio tiene prioridad (mejor calidad)
FISH_AUDIO_API_KEY=...
DEEPGRAM_API_KEY=...

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE=false
NEXT_PUBLIC_ENABLE_IMAGES=false
NEXT_PUBLIC_ENABLE_MULTIPLAYER=false
NEXT_PUBLIC_ENABLE_CARDS=false
NEXT_PUBLIC_ENABLE_MCP_SERVER=false
NEXT_PUBLIC_ENABLE_COMBAT_TRACKER=false
NEXT_PUBLIC_TUTORIAL_MODE=true

# Config
# Modelos de IA (server-side — NO usar prefijo NEXT_PUBLIC para no exponerlos al cliente)
DM_MODEL=claude-sonnet-4-6
UTILITY_MODEL=claude-haiku-4-5-20251001
PARTY_CHECK_INTERVAL=3
SESSION_SUMMARIZE_INTERVAL=6
MAX_CONTEXT_TOKENS=4000
CIRCUIT_BREAKER_THRESHOLD=3

# Seguridad y límites
# Secret para firmar la cookie de guest (cualquier string largo aleatorio).
# Si falta, usa CLERK_SECRET_KEY como fallback.
GUEST_COOKIE_SECRET=
# Poner en true DESPUÉS de 7+ días de deploy para rechazar cookies legacy sin firma
GUEST_COOKIE_STRICT=false
# Activar enforcement de planes/billing el día del launch de Paddle
BILLING_ENFORCED=false
# Turnos máximos de jugador por sesión de invitado (demo)
GUEST_TURN_CAP=15
# Días de retención de usuarios guest antes de borrarlos (cron)
GUEST_RETENTION_DAYS=14
# Secret para el cron de Vercel (Settings > Environment Variables; Vercel lo manda como Bearer)
CRON_SECRET=
# Emails de admin separados por coma (reemplaza la lista hardcodeada en código)
ADMIN_EMAILS=
